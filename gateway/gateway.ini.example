# PRISMX MT5 Gateway 配置
#
# 用法:复制本文件为 gateway.ini,填入真实值。
# gateway.ini 含明文密码,已在 .gitignore 里排除,不要提交进版本库。

[mt5]
# MT5 服务器地址(填券商提供的 Manager 接入地址)
server = mt5server.example.com:443

# Manager 账号
manager_login = 12345
manager_password = 请填真实密码

[http]
# 监听地址。默认只监听本机回环。
#
# 重要:不要改成 0.0.0.0 直接暴露公网。这个接口能读全体客户资料、
# 能代客下单。跨机访问请用 WireGuard 隧道(见 WIREGUARD.md),生产写
#   listen = http://+:8800/
# 并**同时**填下面的 allowed_ips,不要把唯一防线放在云控制台里
# (安全组一次误配、或换机迁移忘了带规则,这个接口就直接到公网上了)。
#
# 关于"绑隧道 IP 会 503":2026-09-06 实测 HttpListener 绑到 WireGuard 网卡的具体
# IP(如 10.66.0.2)后 HTTP.SYS 对所有请求直接回 503,改回 + 立即正常,当时记为
# 「原因未明」。HTTP.SYS 对**具体 IP 前缀**回 503 的常见原因是 URL 保留(urlacl)
# 缺失或前缀冲突,而不是 WireGuard 本身——绑 + 时用的是通配前缀,走的是另一条
# 授权规则,所以只有绑具体 IP 才会被拒。上 VPS 按这个顺序验证一次:
#   netsh http show urlacl              # 看有没有 http://10.66.0.2:8800/ 的保留
#   netsh http show servicestate        # 看有没有别的进程占着冲突前缀
#   netsh http add urlacl url=http://10.66.0.2:8800/ user=SYSTEM
# 加完再把 listen 改成隧道 IP 复测。能绑住的话,全网卡监听这件事就不必再做了。
listen = http://127.0.0.1:8800/

# 允许调用的来源 IP,逗号分隔,精确匹配。留空 = 不限制。
#
# listen 绑在全网卡(http://+:8800/)时,这一项是网关自己这层的防线,不填的话
# 启动会直接被拒绝(除非写了 i_know_what_im_doing)。填后端那台机器的隧道地址:
#   allowed_ips = 10.66.0.1
allowed_ips =

# 后端调用时必须带的 X-Gateway-Token 头。至少 16 位。
# 生成一个随机值(PowerShell):
#   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
api_token = 请填一个随机长字符串

[trade]
# 只允许操作这些组的账号,逗号分隔,前缀匹配,大小写不敏感。
# 留空 = 不限制(危险)。
#
# 测试阶段务必限定 demo 组,防止误操作真实资金。
# 具体组名先跑 selftest 看输出里的"组别"字段,再填这里。
#
# 券商开通真仓接入后,把真仓组的前缀追加在后面(逗号分隔),不要删掉 demo。
# 前缀要写精确:这是代客下单的最后一道闸,宽前缀等于对该券商全部账号开放。
allowed_groups = demo

# 成交回执等待上限(毫秒)
dealer_timeout_ms = 60000

# HTTP 处理线程数。每个线程处理完一个请求才回去 accept,所以这就是并发上限。
# 一次平仓最坏 = dealer_timeout_ms + 两次确认重读;线程数偏小时,几笔卡住的慢单
# 就会把**所有**接口(含不鉴权的 /health)排到队尾,监控会误判成"网关失联"。
http_threads = 16

# 显式解除两条启动检查(allowed_groups 为空、绑全网卡却没配 allowed_ips)。
# 这两条各自都是最后一道闸,只在临时排障时打开,别长期留着。
# i_know_what_im_doing = true

# 下单时写入 comment 的前缀。
# Manager API 没有 magic 字段,靠这个前缀识别本平台开的仓位。
comment_prefix = PRISMX

# 启动与重连后立即选中的品种,逗号分隔,填**券商的真实品种名(含后缀)**。
#
# Manager 只收到"已选中"品种的行情:某个品种进程起来后的第一笔单要先选中、再等
# 服务器推来首个 tick(几十到几百毫秒)。这里点名的品种把这步提前到启动时做。
# 下过单的品种会被自动记住、重连后自动重选,所以这项只影响"进程启动后每个品种
# 的第一笔"。填错名字只会在日志里记一条警告,不影响其它品种。
# 具体品种名先跑 selftest 或看 /symbols 的输出,例如:
#   preselect_symbols = XAUUSD.s, EURUSD.s, BTCUSD.s
# 留空 = 不预选。
preselect_symbols =
