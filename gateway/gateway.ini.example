# PRISMX MT5 Gateway 配置
#
# 用法:复制本文件为 gateway.ini,填入真实值。
# gateway.ini 含明文密码,已在 .gitignore 里排除,不要提交进版本库。

[mt5]
# MT5 服务器地址(填券商提供的 Manager 接入地址)
server = mt5server.example.com:443

# Manager 账号
manager_login = 12345
manager_password = 请填真实密码

[http]
# 监听地址。默认只监听本机回环。
#
# 重要:不要改成 0.0.0.0 直接暴露公网。这个接口能读全体客户资料、
# 能代客下单。跨机访问请用 WireGuard 隧道(见 WIREGUARD.md),生产写
#   listen = http://+:8800/
# 并靠云安全组不放行 8800 让公网看不到它。**不要**写隧道 IP(如 10.66.0.2):
# 2026-09-06 实测 HttpListener 绑到 WireGuard 网卡的具体 IP 后 HTTP.SYS 对所有
# 请求直接回 503,原因未明,改回 + 立即正常。
listen = http://127.0.0.1:8800/

# 后端调用时必须带的 X-Gateway-Token 头。至少 16 位。
# 生成一个随机值(PowerShell):
#   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
api_token = 请填一个随机长字符串

[trade]
# 只允许操作这些组的账号,逗号分隔,前缀匹配,大小写不敏感。
# 留空 = 不限制(危险)。
#
# 测试阶段务必限定 demo 组,防止误操作真实资金。
# 具体组名先跑 selftest 看输出里的"组别"字段,再填这里。
#
# 券商开通真仓接入后,把真仓组的前缀追加在后面(逗号分隔),不要删掉 demo。
# 前缀要写精确:这是代客下单的最后一道闸,宽前缀等于对该券商全部账号开放。
allowed_groups = demo

# 成交回执等待上限(毫秒)
dealer_timeout_ms = 60000

# 下单时写入 comment 的前缀。
# Manager API 没有 magic 字段,靠这个前缀识别本平台开的仓位。
comment_prefix = PRISMX

# 启动与重连后立即选中的品种,逗号分隔,填**券商的真实品种名(含后缀)**。
#
# Manager 只收到"已选中"品种的行情:某个品种进程起来后的第一笔单要先选中、再等
# 服务器推来首个 tick(几十到几百毫秒)。这里点名的品种把这步提前到启动时做。
# 下过单的品种会被自动记住、重连后自动重选,所以这项只影响"进程启动后每个品种
# 的第一笔"。填错名字只会在日志里记一条警告,不影响其它品种。
# 具体品种名先跑 selftest 或看 /symbols 的输出,例如:
#   preselect_symbols = XAUUSD.s, EURUSD.s, BTCUSD.s
# 留空 = 不预选。
preselect_symbols =
