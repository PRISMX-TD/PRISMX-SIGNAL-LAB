# 网关 VPS（Windows）的 WireGuard 配置 —— 粘进 WireGuard 客户端「添加空隧道」的编辑框
# Gateway VPS (Windows) WireGuard config — paste into the client's "Add empty tunnel" editor
#
# 客户端新建空隧道时会自动生成 [Interface] 的 PrivateKey，只需补上 Address 和 [Peer]。
# The client generates [Interface] PrivateKey for a new empty tunnel; add Address and [Peer].

[Interface]
# 客户端自动生成，保留 / generated by the client, keep it
PrivateKey = <网关私钥 gateway-private-key>
Address = 10.66.0.2/24

[Peer]
# 后端 VPS 的公钥：cat /etc/wireguard/publickey / the backend VPS's public key
PublicKey = <后端公钥 backend-public-key>
# 后端 VPS 的公网 IP + WireGuard 端口 / backend VPS public IP + WireGuard port
Endpoint = <后端公网IP backend-public-ip>:51820
AllowedIPs = 10.66.0.1/32
# 每 25 秒发一个保活包：Windows 侧在 NAT/安全组后面，靠它保持映射、掉线自动重连
# Keepalive every 25s: the Windows side sits behind NAT/SG; this keeps the mapping alive
PersistentKeepalive = 25
