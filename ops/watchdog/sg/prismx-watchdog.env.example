# PRISMX 后端看门狗配置。装好后在 /etc/prismx-watchdog.env（权限 600，属主 root）。
# 改完执行：sudo systemctl restart prismx-watchdog
# 没写的项用脚本里的默认值，下面列的就是默认值。

# 通知里显示的机器名
MACHINE_LABEL=SG 后端

# ---- 自动重启后端 ----
SERVICE=prismx
BACKEND_URL=http://127.0.0.1:8000/
# 每隔多少秒查一次；连续多少轮不响应就重启（30 秒 × 4 轮 ≈ 2 分钟）
CHECK_EVERY=30
FAIL_LIMIT=4
HTTP_TIMEOUT=5
# 服务刚启动不到这么多秒时不判断（启动要时间）
STARTUP_GRACE=180
# 1 小时内最多自动重启几次，用完就停手并报警
MAX_RESTARTS_PER_HOUR=3

# ---- 只报警的检查 ----
# 后端 .env 的位置：发信密钥、GATEWAY_URL、REDIS_URL 没在本文件里写时从那里借
BACKEND_ENV=/home/ubuntu/PRISMX-SIGNAL-LAB/backend/.env
# 留空 = 用后端 .env 里的 GATEWAY_URL + /health
GATEWAY_HEALTH_URL=
GATEWAY_DOWN_ALERT_SEC=180
REDIS_DOWN_ALERT_SEC=90
DISK_ALERT_PCT=90
# 同一条持续性警报（硬盘满、停手）多久重复提醒一次
REPEAT_ALERT_SEC=1800

# ---- 通知（默认都关着）----
# 邮件：走 Resend。RESEND_API_KEY / MAIL_FROM 留空就用后端 .env 里那份
EMAIL_ENABLED=false
EMAIL_TO=rexleekang16@gmail.com
RESEND_API_KEY=
MAIL_FROM=

# Telegram：先找 @BotFather 建机器人拿 token；把机器人拉进管理员群，
# chat id 用逗号分隔，可以填多个（个人或群都行，群 id 是负数）
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
