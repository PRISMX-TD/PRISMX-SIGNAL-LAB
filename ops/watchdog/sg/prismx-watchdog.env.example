# PRISMX 后端看门狗配置。装好后在 /etc/prismx-watchdog.env（权限 600，属主 root）。
# 改完执行：sudo systemctl restart prismx-watchdog
# 没写的项用脚本里的默认值，下面列的就是默认值。

# 通知里显示的机器名
MACHINE_LABEL=SG 后端

# ---- 自动重启后端 ----
SERVICE=prismx
BACKEND_URL=http://127.0.0.1:8000/
# 每隔多少秒查一次；连续多少轮不响应就重启（30 秒 × 4 轮 ≈ 2 分钟）
CHECK_EVERY=30
FAIL_LIMIT=4
HTTP_TIMEOUT=5
# 服务刚启动不到这么多秒时不判断（启动要时间）
STARTUP_GRACE=180
# 1 小时内最多自动重启几次，用完就停手并报警
MAX_RESTARTS_PER_HOUR=3

# ---- 只报警的检查 ----
# 后端 .env 的位置：发信密钥、GATEWAY_URL、REDIS_URL 没在本文件里写时从那里借
BACKEND_ENV=/home/ubuntu/PRISMX-SIGNAL-LAB/backend/.env
# 留空 = 用后端 .env 里的 GATEWAY_URL + /health
GATEWAY_HEALTH_URL=
GATEWAY_DOWN_ALERT_SEC=180
REDIS_DOWN_ALERT_SEC=90
DISK_ALERT_PCT=90
# 同一条持续性警报（硬盘满、停手）多久重复提醒一次
REPEAT_ALERT_SEC=1800

# ---- 通知（默认都关着）----
# 邮件：走 Resend。RESEND_API_KEY / MAIL_FROM 留空就用后端 .env 里那份
EMAIL_ENABLED=false
EMAIL_TO=rexleekang16@gmail.com
RESEND_API_KEY=
MAIL_FROM=

# Telegram：先找 @BotFather 建机器人拿 token；把机器人拉进管理员群，
# chat id 用逗号分隔，可以填多个（个人或群都行，群 id 是负数）
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ---- 运维接口（管理后台的「重启后端」「重启 gateway」按钮）----
# 只听本机，nginx 把 /ops/ 转进来（install.sh 装 snippets/prismx-ops.conf）。留空 = 关掉。
OPS_LISTEN=127.0.0.1:8790
# 运维口令表：只存哈希。用 --add-operator 名字 生成，--remove-operator 名字 删除
OPS_OPERATORS_FILE=/etc/prismx-watchdog.operators
OPS_HISTORY_FILE=/var/log/prismx-watchdog/ops-history.jsonl
# 同一个按钮多少秒内只能按一次；口令输错几次锁多久
OPS_COOLDOWN=300
OPS_LOCK_FAILS=5
OPS_LOCK_SEC=900
# 允许哪些网页来源调用（逗号分隔）。留空 = 正式站 + 备用域名 + 本地开发
OPS_CORS_ORIGINS=
# 只有管理员能用运维接口：拿浏览器的登录 token 去问后端一个只有管理员能看的接口。
# 留空 = BACKEND_URL + api/admin/trial。确认过的管理员（用户 id + 会话版本）记在下面的文件里，
# 后端挂了的时候，这么多秒内在这里确认过的管理员仍能按按钮（默认 7 天）。
OPS_ADMIN_CHECK_URL=
OPS_ADMIN_CACHE_FILE=/var/lib/prismx-watchdog/ops-admins.json
OPS_ADMIN_CACHE_SEC=604800
# 与 VPS 看门狗共用的签名密钥（install.sh 会自动生成一把）；两边必须一样
OPS_SHARED_SECRET=
VPS_OPS_URL=http://10.66.0.2:8791
